# TinkerClaw — llama-server systemd unit (Dragon ARM64)
#
# Serves the Local LLM on localhost:1234 with the OpenAI-compatible API
# LM Studio uses.  Dragon's `lmstudio_llm` backend
# (dragon_voice/llm/lmstudio_llm.py) talks to this on Local + Hybrid
# voice-mode paths.
#
# Default model (2026-05-17): **LFM2.5-VL-1.6B Q8_0** (LiquidAI).
# - Aced the tool-routing gauntlet 10/10 with directive system prompt
#   (vs ministral 7/10), and brings vision for free.
# - 1.25 GB Q8_0 + 583 MB Q8_0 mmproj.  Bumped from Q4_0 (696 MB)
#   2026-05-17 — Q8 emits cleaner verbs per-turn but doesn't fix the
#   multi-turn state-tracking gap (browser-agent loop still can't
#   reliably issue browser_done — that's a 1.6 B param ceiling, not
#   a precision issue).  See docs/BROWSER-HARNESS.md.
# - ~14 s/turn warm on Q6A, ~40 s for image-prompts.
# - Tool dialect 5: `<|tool_call_start|>[name(arg="v")]<|tool_call_end|>`
#   parsed by `dragon_voice/tools/parser.py` (Dialect 5, 2026-05-17).
# - Requires `--jinja` so the ChatML stops are recognised; this is
#   fine with LFM (unlike Ministral which barfed on strict alternation).
#
# Safe fallback: ministral-3:3b at /home/radxa/llama.cpp/models/ministral/
# - Known-good with Dragon's existing system prompt (no behavioral tuning
#   needed).  Swap by editing --model + removing --mmproj + removing --jinja.
#
# Pre-reqs (one-time install on Dragon):
#   - llama.cpp built at /home/radxa/llama.cpp/build/bin/llama-server
#   - GGUFs under /home/radxa/llama.cpp/models/{lfm25_vl,ministral}/
#   - This unit copied to /etc/systemd/system/, daemon-reload, enable + start
#
# To swap models: edit ExecStart's --model arg, run
#   sudo systemctl restart tinkerclaw-llama-server
#
# Pair-with: edit /home/radxa/dragon_voice/config.yaml so
#   llm.backend = "lmstudio"
#   llm.local_backend = "lmstudio"
#   llm.lmstudio_url = "http://localhost:1234/v1"
# then restart tinkerclaw-voice.

[Unit]
Description=TinkerClaw llama-server (LM Studio compat, LFM2.5-VL on ARM64)
After=network.target
Wants=network.target

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/llama.cpp
ExecStart=/home/radxa/llama.cpp/build/bin/llama-server \
  --model /home/radxa/llama.cpp/models/lfm25_vl/model-q8_0.gguf \
  --mmproj /home/radxa/llama.cpp/models/lfm25_vl/mmproj-q8.gguf \
  --port 1234 \
  --host 127.0.0.1 \
  --ctx-size 16384 \
  --threads 8 \
  --jinja \
  --log-disable
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
